        "jsCode": "const item = $input.item.json;\nconst payload = {\n  channel: \"#dev-alerts\",\n  text: `⚠️ *P2 MAJOR* | ${item.service} (${item.env})\\n*Incident:* ${item.incidentId}\\n*Signature:* ${item.errorSignature}\\n*Impacted Users:* ${item.impactedUsers}\\n>${item.message}`\n};\nreturn { json: { incidentId: item.incidentId, severity: item.severity, dispatchPayload: payload } };"
      },
