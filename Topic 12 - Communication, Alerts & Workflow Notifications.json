        "jsCode": "return [\n  { json: { incidentId: \"INC-901\", service: \"payment-gateway\", errorSignature: \"AUTH_TIMEOUT_504\", message: \"Upstream bank gateway response latency exceeded 8000ms\", impactedUsers: 240, env: \"production\" } },\n  { json: { incidentId: \"INC-902\", service: \"payment-gateway\", errorSignature: \"AUTH_TIMEOUT_504\", message: \"Upstream bank gateway response latency exceeded 8200ms\", impactedUsers: 310, env: \"production\" } },\n  { json: { incidentId: \"INC-903\", service: \"search-indexer\", errorSignature: \"HEAP_MEMORY_WARN_85\", message: \"Elasticsearch node heap utilization exceeded 85%\", impactedUsers: 0, env: \"staging\" } }\n];"
      },
      "id": "9d93dea0-529c-4d89-94fa-297e0cdd319d",
      "name": "Code_SimulateIncidents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -944,
        208
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.alertCache = staticData.alertCache || {};\nconst item = $input.item.json;\nconst now = Date.now();\nconst throttleWindowMs = 15 * 60 * 1000; // 15-minute suppression window\n\n// TTL cleanup to prevent unbounded cache growth\nfor (const k of Object.keys(staticData.alertCache)) {\n  if (now - staticData.alertCache[k] > throttleWindowMs * 4) delete staticData.alertCache[k];\n}\n\n// 1. Severity classification\nlet severity = \"P3_MINOR\";\nif (item.impactedUsers > 100 && item.env === \"production\") {\n  severity = \"P1_CRITICAL\";\n} else if (item.env === \"production\" || item.impactedUsers > 0) {\n  severity = \"P2_MAJOR\";\n}\n\n// 2. Throttling key by service + errorSignature\nconst throttleKey = `${item.service}:${item.errorSignature}`;\nconst lastAlertTime = staticData.alertCache[throttleKey] || 0;\nconst isThrottled = (now - lastAlertTime) < throttleWindowMs;\nif (!isThrottled) {\n  staticData.alertCache[throttleKey] = now;\n}\n\nreturn {\n  json: {\n    ...item,\n    severity: severity,\n    isThrottled: isThrottled,\n    shouldAlert: !isThrottled,\n    throttleKey: throttleKey,\n    evaluatedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "0adc3b22-b2fa-4f6f-b706-a21138ef73f7",
      "name": "Code_EvaluateSeverityAndThrottle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
