    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst blockKitPayload = {\n  channel: \"#critical-incidents\",\n  text: `🚨 P1 CRITICAL INCIDENT: ${item.service}`,\n  blocks: [\n    {\n      type: \"header\",\n      text: { type: \"plain_text\", text: `🚨 P1 CRITICAL: ${item.service.toUpperCase()}`, emoji: true }\n    },\n    {\n      type: \"section\",\n      fields: [\n        { type: \"mrkdwn\", text: `*Incident ID:*\\n\\`${item.incidentId}\\`` },\n        { type: \"mrkdwn\", text: `*Environment:*\\n\\`${item.env.toUpperCase()}\\`` },\n        { type: \"mrkdwn\", text: `*Impacted Users:*\\n*${item.impactedUsers}*` },\n        { type: \"mrkdwn\", text: `*Signature:*\\n\\`${item.errorSignature}\\`` }\n      ]\n    },\n    {\n      type: \"section\",\n      text: { type: \"mrkdwn\", text: `*Diagnostic Message:*\\n>${item.message}` }\n    }\n  ]\n};\nreturn { json: { incidentId: item.incidentId, severity: item.severity, dispatchPayload: blockKitPayload } };"
      },
      "id": "1e49fc79-312b-45c2-af19-75d55077f35f",
